<UserControl x:Class="RadioV2.Controls.StationArtwork"
             x:Name="Artwork"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:RadioV2.Helpers"
             Focusable="False" IsHitTestVisible="False"
             AutomationProperties.Name="{Binding StationName, ElementName=Artwork}">
    <Border CornerRadius="6" Background="{ui:ThemeResource ControlFillColorSecondaryBrush}">
        <Grid>
            <Viewbox Margin="6" Stretch="Uniform" StretchDirection="DownOnly">
                <Viewbox.Style>
                    <Style TargetType="Viewbox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source, ElementName=Logo}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Viewbox.Style>
                <TextBlock Text="{Binding Initials, ElementName=Artwork}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            </Viewbox>
            <Image x:Name="Logo" Stretch="Uniform"
                   helpers:AsyncImageLoader.Source="{Binding Source, ElementName=Artwork}" />
        </Grid>
    </Border>
</UserControl>
